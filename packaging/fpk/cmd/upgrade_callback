#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/_common"

log_info "Running upgrade_callback..."
check_docker_ready
load_saved_config

ensure_runtime_image 1
save_config_file
prepare_and_render_compose "upgrade"

if ! run_compose up -d --remove-orphans >> "${LOG_FILE}" 2>&1; then
  fail_with_msg "升级后启动 TRIM Music Hub 容器失败，请查看日志 ${LOG_FILE}。"
fi

wait_for_service_ready || true
log_info "upgrade_callback completed successfully."
exit 0
