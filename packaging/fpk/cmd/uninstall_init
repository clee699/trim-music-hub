#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/_common"

log_info "Running uninstall_init..."

if command -v docker >/dev/null 2>&1; then
  if [ -f "${COMPOSE_FILE}" ]; then
    run_compose down --remove-orphans >> "${LOG_FILE}" 2>&1 || true
  fi
  docker rm -f "${CONTAINER_NAME}" >> "${LOG_FILE}" 2>&1 || true

  # Clean up locally built fpk images while leaving shared base images untouched
  local_imgs="$(docker images --format '{{.Repository}}:{{.Tag}}' 'trim-music-hub-fpk' 2>/dev/null || true)"
  if [ -n "${local_imgs}" ]; then
    echo "${local_imgs}" | xargs -r docker rmi >> "${LOG_FILE}" 2>&1 || true
  fi
fi

rm -f "${SOCKET_FILE}" 2>/dev/null || true
exit 0
