#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/_common"

case "${1:-}" in
  start)
    check_docker_ready
    if is_container_running; then
      exit 0
    fi
    load_saved_config
    ensure_runtime_image 0
    save_config_file
    prepare_and_render_compose "start"
    if ! run_compose up -d --remove-orphans >> "${LOG_FILE}" 2>&1; then
      fail_with_msg "启动 TRIM Music Hub 失败，请查看日志 ${LOG_FILE}。"
    fi
    if ! wait_for_service_ready; then
      fail_with_msg "容器启动异常退出，请查看日志 ${LOG_FILE}。"
    fi
    exit 0
    ;;
  stop)
    if command -v docker >/dev/null 2>&1; then
      if [ -f "${COMPOSE_FILE}" ]; then
        run_compose stop >> "${LOG_FILE}" 2>&1 || docker stop "${CONTAINER_NAME}" >> "${LOG_FILE}" 2>&1 || true
      else
        docker stop "${CONTAINER_NAME}" >> "${LOG_FILE}" 2>&1 || true
      fi
    fi
    rm -f "${SOCKET_FILE}" 2>/dev/null || true
    exit 0
    ;;
  status)
    if command -v docker >/dev/null 2>&1 && is_container_running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    fail_with_msg "不支持的控制指令：${1:-<empty>}"
    ;;
esac
