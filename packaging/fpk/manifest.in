desc                  = 飞牛音乐全能管理中枢：支持网易云/QQ音乐歌单导入、多音源无损搜索下载、歌单直通同步与曲库去重治理。
platform              = @PLATFORM@
source                = thirdparty
maintainer            = @MAINTAINER@
