# =================================================================
# TRIM Music Hub 环境配置模板
# 复制此文件为 .env 并按需修改：cp .env.example .env
# =================================================================

# 1. 服务监听端口 (开发环境默认 3175，Docker 生产环境默认 4175)
PORT=3175
HOST_PORT=4175

# 2. 宿主机音乐文件保存根目录 (必填)
MUSIC_PATH=/vol1/1000/Music
MUSIC_DIR=/vol1/1000/Music

# 3. 本地持久化数据目录 (开发环境与生产环境严格隔离)
DATA_DIR=./data

# 4. 飞牛音乐官方应用数据库路径与目录
FNOS_DB_DIR=/usr/local/apps/@appdata/trim.music/db
FNOS_DB_PATH=/usr/local/apps/@appdata/trim.music/db/music.db

# 5. 飞牛音乐官方应用封面缓存目录 (需读写权限以支持歌单封面同步)
FNOS_COVER_DIR=/vol1/@appmeta/trim.music/cover

# 6. 文件写入所有者权限 (通常飞牛主用户为 1000:1000)
PUID=1000
PGID=1000

# 7. 默认关联的飞牛用户 (如 admin)
DEFAULT_USER=admin

# 8. 可选：跨机离线开发兜底管理员凭据与会话签名密钥
# ADMIN_USER=admin
# ADMIN_PASSWORD=change_me
# AUTH_SECRET=replace_with_random_secret

# 9. 时区
TZ=Asia/Shanghai
